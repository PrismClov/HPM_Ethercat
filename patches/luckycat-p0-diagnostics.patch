@@ -32,6 +32,16 @@
 #include "ecat_config.h"
 #include "hpm_gpio_drv.h"
 
+
+static uint32_t output_map_cycle;
+static bool output_map_valid;
+
+static inline uint32_t pdi_cycle_count(void)
+{
+    uint32_t cycles;
+    __asm volatile ("csrr %0, mcycle" : "=r"(cycles) :: "memory");
+    return cycles;
+}
 
 UINT32 APPL_GetDipSw(void);
 void APPL_SetLed(UINT32 value);
@@ -258,7 +268,18 @@
 */
 void APPL_InputMapping(UINT16 *pData)
 {
-    MEMCPY(pData, &InputCounter0x6000, SIZEOF(InputCounter0x6000));
+    const uint32_t now = pdi_cycle_count();
+    uint32_t phase_us = 0xffffu;
+    if (output_map_valid) {
+        uint32_t elapsed_us = (now - output_map_cycle) / (BOARD_CPU_FREQ / 1000000u);
+        if (elapsed_us < 0xffffu) {
+            phase_us = elapsed_us;
+        }
+    }
+
+    /* Keep GPIO inputs in the low half; report PDI phase in the high half. */
+    uint32_t input_pdo = (InputCounter0x6000 & 0xffffu) | (phase_us << 16);
+    MEMCPY(pData, &input_pdo, SIZEOF(input_pdo));
 }
 
